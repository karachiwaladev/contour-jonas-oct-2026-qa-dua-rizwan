# Never auto-commit dependencies, build output or secrets.
node_modules/
__pycache__/
*.pyc
.env
.env.*
*.pem
*.key
.DS_Store
Thumbs.db

# The prompt log is part of the factory's record and must stay tracked.
# These negations override broader rules such as "logs/" or "*.jsonl",
# including any in a global gitignore. Keep them at the end of this file.
!.claude/
!.claude/logs/
!.claude/logs/prompts.jsonl
